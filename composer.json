    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "psalm": "psalm --no-cache --threads=1",
    "test": "phpunit --configuration phpunit.xml"
  },
  "config": {
    "platform": {
      "php": "8.2.27"
    },
    "sort-packages": true
  }
}
