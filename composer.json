{
  "name": "dma/media-embedding-connector",
  "description": "Media Embedding Connector app for Nextcloud",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Digitale Medien der Armee DMA",
      "email": "support@dma.swiss"
    }
  ],
  "autoload": {
    "psr-4": {
      "OCA\\MediaEmbeddingConnector\\": "lib/"
    }
  },
  "require": {
    "php": ">=8.2 <8.6"
  },
  "require-dev": {
    "nextcloud/ocp": "^34.0",
